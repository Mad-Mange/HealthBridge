    <!-- Privacy policy (shown from Health Connect) -->
    <string name="privacy_title">Privacy in HealthBridge</string>
    <string name="privacy_what">HealthBridge fetches your measurements (weight, body composition, blood pressure, heart rate, sleep and activity) from your Withings account and writes them to Health Connect on this phone, so that Samsung Health and other apps can see them.</string>
    <string name="privacy_read">The app reads data from Health Connect (for example from Samsung Health) only to show the overview and for an export to a CSV file that you choose to save yourself.</string>
    <string name="privacy_where">No health data is sent to any server other than Withings\' own API. Login keys are stored encrypted on the phone and can be removed at any time with \"Disconnect Withings\".</string>
